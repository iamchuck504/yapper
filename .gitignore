# Dependencies
node_modules/

# Build output
dist/
out/

# Local meeting data (audio/transcripts/notes live in the user's Documents, but ignore any that land here)
Meetings/
*.webm
*.m4a
*.wav
*.mp3

# ...except the calibration sample, which the app needs to measure the machine
# it is running on (11 s of public-domain speech, from whisper.cpp)
!build/calibration.wav

# OS / editor
.DS_Store
Thumbs.db
*.log

# transient build/verification artifacts
build/shots/
renderer/.pdf-export.html
build/icon-candidates/
build/icon-v*/
build/icon-preview.png
build/whisper/

# whisper.cpp binaries and models (downloaded by setup, never committed).
# Without the trailing slash too: on a dev machine these are often symlinks to
# an installed copy's engine, and a symlink is a file, not a directory.
bin/
models/
bin
models

# compiled from mac/*.swift by mac/build-app.sh, per machine
build/mic-probe
build/system-audio
